# Copy this file to .env and fill in the values you need.
# Never commit .env — it is listed in .gitignore.

# ─── App ─────────────────────────────────────────────────────────────────────

# Deployed Kameti contract address (Arc Testnet default used when unset)
VITE_CONTRACT_ADDRESS=

# Circle id of the demo circle shown on the home page (set by scripts/seed-demo.ts)
VITE_DEMO_CIRCLE_ID=

# Circle id of the Attack Lab circle used by /break attacks 1–4 (set by scripts/seed-attack-lab.ts)
VITE_ATTACK_LAB_ID=

# Set to "true" to enable mainnet CCTP bridge routes on the /bridge page
VITE_BRIDGE_MAINNET=

# ─── RPC proxy (Arc Studio — optional outside Arc Studio) ────────────────────

# Injected by Arc Studio; not needed when using public RPC
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=

# ─── Circle Smart Contract Platform / developer-controlled wallets ────────────
# Required only when deploying via scripts/self-deploy.ts or scripts/compass-deploy.ts

CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# ─── Demo seed wallets (written by scripts/seed-demo.ts on first run) ─────────
# 66-character hex private keys — never commit real values

SEED_KEY_0=
SEED_KEY_1=
SEED_KEY_2=
SEED_KEY_3=
